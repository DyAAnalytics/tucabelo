# ===================================================
# Tucabelo - Apache Configuration
# ===================================================

# Forzar UTF-8 en todos los responses HTML, CSS y JS
AddDefaultCharset UTF-8
AddCharset UTF-8 .html .htm .css .js .json .txt .xml

# Asegura el Content-Type correcto para tipos comunes
<IfModule mod_mime.c>
  AddType text/html;charset=UTF-8 .html .htm
  AddType text/css;charset=UTF-8 .css
  AddType application/javascript;charset=UTF-8 .js
  AddType application/json;charset=UTF-8 .json
  AddType image/png .png
  AddType image/webp .webp
  AddType image/jpeg .jpg .jpeg
  AddType image/svg+xml .svg
  AddType image/x-icon .ico
</IfModule>

# Seguridad básica: ocultar versión del servidor
ServerSignature Off

# Caché para assets estáticos (mejora performance)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 week"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Comprimir responses para mejor performance
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json text/plain image/svg+xml
</IfModule>
